ile()] if UPLOAD_DIR.exists() else []
    return render(request,'admin_launch.html',{
        'demo_counts':demos,'structure_version':structure,'backups':backups,
        'student_count':student_count,'secure_cookie':os.getenv('PMS_SECURE_COOKIE','0')=='1',
        'backup_enabled':os.getenv('PMS_BACKUP_ENABLED','1')=='1','db_path':str(DB_PATH),
        'db_size':db_size,'upload_count':upload_count,'last_backup':backups[0] if backups else None
    })

@app.post('/admin/launch/prepare-production')
def admin_prepare_production(request: Request, confirmation: str=Form(...)):
    a=require_admin(request,super_only=True)
    if confirmation.strip().upper()!='PREPARE ASCEND':
        return flash_redirect('/admin/launch','Type PREPARE ASCEND exactly to confirm.','error')
    create_backup('before-production-prepare')
    with connect() as conn:
        removed=purge_known_demo_content(conn)
        added=install_starter_structure(conn,a['id'])
        conn.execute('INSERT INTO settings(key,value) VALUES ("registration_enabled","0") ON CONFLICT(key) DO UPDATE SET value="0"')
        audit(conn,a['id'],'production_prepared',json.dumps({'removed':removed,'added':added}))
    return flash_redirect('/admin/launch',f'Production preparation complete. Demo content cleaned, registration closed, and {added["challenges"]} missing draft challenge templates installed.')

@app.post('/admin/launch/install-structure')
def admin_install_structure(request: Request):
    a=require_admin(request,super_only=True)
    create_backup('before-structure')
    with connect() as conn:
        added=install_starter_structure(conn,a['id'])
        audit(conn,a['id'],'starter_structure_installed',json.dumps(added))
    return flash_redirect('/admin/launch',f'Starter structure ready: {added["achievements"]} achievements, {added["challenges"]} draft challenges and {added["rewards"]} rewards added.')

@app.post('/admin/launch/purge-demo')
def admin_purge_demo(request: Request, confirmation: str=Form(...)):
    a=require_admin(request,super_only=True)
    if confirmation.strip().upper()!='REMOVE DEMO':
        return flash_redirect('/admin/launch','Type REMOVE DEMO exactly to confirm.','error')
    create_backup('before-demo-cleanup')
    with connect() as conn:
        removed=purge_known_demo_content(conn)
        conn.execute('INSERT INTO settings(key,value) VALUES ("registration_enabled","0") ON CONFLICT(key) DO UPDATE SET value="0"')
        audit(conn,a['id'],'demo_content_removed',json.dumps(removed))
    return flash_redirect('/admin/launch',f'Demo cleanup complete. Removed {removed["students"]} demo students and known demo content.')

@app.post('/admin/backups/create')
def admin_backup_create(request: Request):
    a=require_admin(request,super_only=True)
    path=create_backup('manual'); prune_backups()
    with connect() as conn: audit(conn,a['id'],'manual_backup_created',path.name if path else 'none')
    return flash_redirect('/admin/launch','Backup created successfully.' if path else 'No database was available to back up.','success' if path else 'error')

@app.get('/admin/backups/{filename}')
def admin_backup_download(request: Request, filename: str):
    require_admin(request,super_only=True)
    if not re.fullmatch(r'ascend_[a-z0-9_-]+_\d{8}_\d{6}\.(?:db|zip)',filename): raise HTTPException(404)
    data=backup_bytes(filename)
    if data is None: raise HTTPException(404)
    return Response(data, media_type='application/zip' if filename.endswith('.zip') else 'application/octet-stream', headers={'Content-Disposition':f'attachment; filename="{filename}"'})

@app.post('/admin/security/password')
def admin_change_password(request: Request,current_password:str=Form(...),new_password:str=Form(...),confirm_password:str=Form(...)):
    a=require_admin(request,super_only=True)
    if new_password!=confirm_password: return flash_redirect('/admin/launch','New passwords do not match.','error')
    if len(new_password)<12 or len(new_password)>128 or not re.search(r'[A-Za-z]',new_password) or not re.search(r'\d',new_password):
        return flash_redirect('/admin/launch','Admin password must be 12–128 characters and include letters and numbers.','error')
    if not a['password_hash'] or not verify_password(current_password,a['password_hash']):
        return flash_redirect('/admin/launch','Current admin password is incorrect.','error')
    keep_hash=token_hash(request.cookies.get('pms_session',''))
    with connect() as conn:
        conn.execute('UPDATE users SET password_hash=? WHERE id=?',(hash_password(new_password),a['id']))
        conn.execute('DELETE FROM sessions WHERE user_id=? AND token_hash!=?',(a['id'],keep_hash))
        audit(conn,a['id'],'admin_password_changed','Other admin sessions signed out')
    return flash_redirect('/admin/launch','Admin password updated. Other sessions were signed out.')

@app.get('/internal/scheduled-backup')
def scheduled_backup(request: Request):
    # Vercel sends this bearer token on cron invocations. No token, no backup.
    secret=os.getenv('CRON_SECRET','')
    provided=request.headers.get('authorization','')
    if not secret or not hmac.compare_digest(provided.encode('utf-8'), ('Bearer '+secret).encode('utf-8')):
        raise HTTPException(status_code=403)
    path=run_scheduled_backup_if_due()
    return {'ok': True, 'created': bool(path)}

@app.get('/health')
def health(): return {'ok':True,'app':'ASCEND','version':APP_VERSION}
