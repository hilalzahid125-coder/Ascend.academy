@app.get('/achievements', response_class=HTMLResponse)
def achievements(request: Request):
    u=require_user(request,'student')
    with connect() as conn:
        scores=sync_achievements(conn,u['id'])
        rows=conn.execute('''SELECT a.*,sa.unlocked_at FROM achievements a
                             LEFT JOIN student_achievements sa ON sa.achievement_id=a.id AND sa.user_id=?
                             WHERE a.status='active' ORDER BY a.points_required,a.name''',(u['id'],)).fetchall()
        enriched=[]
        for r in rows:
            d=dict(r); d['current_points']=scores.get(r['category'],0); enriched.append(d)
    return render(request,'achievements.html',{'achievements':enriched})

@app.get('/rewards', response_class=HTMLResponse)
def rewards(request: Request):
    u=require_user(request,'student')
    with connect() as conn:
        points=total_points(conn,u['id'])
        rows=conn.execute('''SELECT r.*,rc.status claim_status,
                             (SELECT COUNT(*) FROM reward_claims reserved WHERE reserved.reward_id=r.id AND reserved.status IN ('approved','fulfilled')) reserved_count
                             FROM rewards r LEFT JOIN reward_claims rc ON rc.reward_id=r.id AND rc.user_id=?
                             WHERE r.status='active' ORDER BY points_required''',(u['id'],)).fetchall()
    return render(request,'rewards.html',{'rewards':rows,'points':points})

@app.post('/rewards/{reward_id}/claim')
def reward_claim(request: Request,reward_id:int):
    u=require_user(request,'student')
    with connect() as conn:
        r=conn.execute('SELECT * FROM rewards WHERE id=? AND status="active"',(reward_id,)).fetchone()
        if not r: return flash_redirect('/rewards','Reward not available.','error')
        if total_points(conn,u['id'])<r['points_required']: return flash_redirect('/rewards','You have not reached the required points yet.','error')
        if r['quantity'] is not None:
            reserved=conn.execute("SELECT COUNT(*) c FROM reward_claims WHERE reward_id=? AND status IN ('approved','fulfilled')", (reward_id,)).fetchone()['c']
            if reserved >= r['quantity']: return flash_redirect('/rewards','This reward is out of stock.','error')
        result=conn.execute('INSERT OR IGNORE INTO reward_claims(reward_id,user_id,status,created_at) VALUES (?,?,"pending",?)',(reward_id,u['id'],iso_now()))
        if result.rowcount:
            notify(conn,u['id'],'Reward claim submitted',f'Your claim for {r["name"]} is awaiting review.')
    return flash_redirect('/rewards','Reward claim submitted.')

@app.get('/profile', response_class=HTMLResponse