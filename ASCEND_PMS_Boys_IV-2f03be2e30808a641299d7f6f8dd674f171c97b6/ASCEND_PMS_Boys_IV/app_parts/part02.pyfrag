uest.cookies.get('pms_csrf') or new_token(24)
    _user=current_user(request)
    try:
        with connect() as _conn:
            _unread=_conn.execute('SELECT COUNT(*) c FROM notifications WHERE user_id=? AND is_read=0',(_user['id'],)).fetchone()['c'] if _user else 0
    except Exception:
        _unread=0
    context.update({'request':request,'settings':settings(),'user':_user,
                    'msg':request.query_params.get('msg'),'kind':request.query_params.get('kind','success'),
                    'csrf_token':csrf,
                    'is_super_admin':is_super_admin(_user),
                    'admin_permissions':_admin_permissions(_user),
                    'staff_permission_labels':STAFF_PERMISSION_LABELS,
                    'app_version':APP_VERSION,'unread_notifications':_unread})
    response = templates.TemplateResponse(request=request, name=name, context=context, status_code=status_code)
    if not request.cookies.get('pms_csrf'):
        set_app_cookie(response,'pms_csrf',csrf)
    return response

def total_points(conn, user_id, category=None, since=None):
    q='SELECT COALESCE(SUM(amount),0) AS total FROM point_transactions WHERE user_id=?'; args=[user_id]
    if category and category!='overall': q+=' AND category=?'; args.append(category)
    if since: q+=' AND created_at>=?'; args.append(since)
    return conn.execute(q,args).fetchone()['total']

def point_totals(conn, user_id):
    rows=conn.execute('SELECT category, COALESCE(SUM(amount),0) total FROM point_transactions WHERE user_id=? GROUP BY category',(user_id,)).fetchall()
    totals={r['category']:r['total'] for r in rows}
    totals['overall']=sum(totals.values())
    return totals

def sync_achievements(conn, user_id):
    # One points aggregation and one achievement lookup, rather than one or
    # more database round trips per achievement on every dashboard visit.
    totals=point_totals(conn,user_id)
    achievements=conn.execute('''SELECT a.*,sa.unlocked_at FROM achievements a
        LEFT JOIN student_achievements sa ON sa.achievement_id=a.id AND sa.user_id=?
        WHERE a.status='active' ORDER BY a.points_required''',(user_id,)).fetchall()
    for ach in achievements:
        if ach['unlocked_at'] is None and totals.get(ach['category'],0)>=ach['points_required']:
            created=conn.execute('INSERT OR IGNORE INTO student_achievements(achievement_id,user_id,unlocked_at) VALUES (?,?,?)',(ach['id'],user_id,iso_now()))
            if created.rowcount:
                notify_student_and_parents(conn,user_id,'achievement','Achievement unlocked',f'You unlocked {ach["name"]}.',
                    'Achievement unlocked',f'{{student_name}} unlocked {ach["name"]}.',student_link='/achievements',parent_link=f'/parent/children/{user_id}/achievements')
    return totals

def audit(conn, admin_id, action, details=''):
    conn.execute('INSERT INTO audit_logs(admin_id,action,details,created_at) VALUES (?,?,?,?)',
                 (admin_id,action,details,iso_now()))

# Notification categories used by the parent notification center. They group
# existing notifications instead of creating a second notification system.
NOTIFICATION_CATEGORIES={
    'absence':'Absence','attendance':'Attendance','assessment':'Assessments','remark':'Teacher remarks',
    'assignment':'Assignments','achievement':'Achievements','challenge':'Challenges','fee':'Fees',
    'fee_reminder':'Fees','fee_overdue':'Fees','announcement':'Announcements','update':'Updates'}
_NOTIFY_TITLE_KINDS={
    'Achievement unlocked':'achievement','Challenge approved':'challenge','Challenge reviewed':'challenge',
    'Reward claim updated':'challenge','Fee assigned':'fee','Fee updated':'fee',
    'Fee payment approved':'fee','Fee payment rejected':'fee'}

def notify(conn, user_id, title, body, kind=None, student_id=None, link_path=None):
    conn.execute('INSERT INTO notifications(user_id,title,body,is_read,kind,student_id,link_path,read_at,created_at) VALUES (?,?,?,0,?,?,?,NULL,?)',
                 (user_id,title,body,kind or _NOTIFY_TITLE_KINDS.get(title,'update'),student_id,link_path,iso_now()))
    # Generic parent alerts remain non-identifying even if a relationship is later revoked.
    if title in _NOTIFY_TITLE_KINDS:
        conn.execute("""INSERT INTO notifications(user_id,title,body,is_read,kind,student_id,link_path,read_at,created_at)
            SELECT parent.id,?,?,0,?,?,?,NULL,? FROM parent_student_links l JOIN users parent ON parent.id=l.parent_id
            WHERE l.student_id=? AND parent.role='parent' AND parent.status='active'""",
            (title,'A linked student has an update. Open the parent workspace for current details.',
             _NOTIFY_TITLE_KINDS[title],student_id,link_path,iso_now(),user_id))

def _already_notified(conn, user_id, kind, student_id, title, body):
    # Portable null-safe equality: "IS ?" is not valid with a bound parameter
    # on PostgreSQL.
    return conn.execute("""SELECT 1 FROM notifications
        WHERE user_id=? AND kind=? AND COALESCE(student_id,-1)=COALESCE(?,-1) AND title=? AND body=? LIMIT 1""",
        (user_id,kind,student_id,title,body)).fetchone() is not None

def notify_student_and_parents(conn, student_id, kind, student_title, student_body, parent_title, parent_body,
                               student_link=None, parent_link=None):
    """Deliver one event to the student and every linked active parent, each with a
    role-appropriate title and body but a shared category and student reference."""
    student=conn.execute('SELECT full_name FROM users WHERE id=?',(student_id,)).fetchone()
    student_name=student['full_name'] if student else 'your student'
    if not _already_notified(conn,student_id,kind,student_id,student_title,student_body):
        notify(conn,student_id,student_title,student_body,kind=kind,student_id=student_id,link_path=student_link)
    for parent in conn.execute("""SELECT u.id,u.full_name FROM parent_student_links l JOIN users u ON u.id=l.parent_id
        WHERE l.student_id=? AND u.role='parent' AND u.status='active'""",(student_id,)).fetchall():
        body=parent_body.format(student_name=student_name,parent_name=parent['full_name'])
        if not _already_notified(conn,parent['id'],kind,student_id,parent_title,body):
            notify(conn,parent['id'],parent_title,body,kind=kind,student_id=student_id,link_path=parent_link)

ANNOUNCEMENT_ROLES={'all':'Everyone','students':'Students','parents':'Parents','teachers':'Teachers'}

def announcement_scope_text(announcement):
    """Human wording for where a notice applies."""
    audience=announcement['audience'] if 'audience' in announcement.keys() else 'all'
    class_name=announcement['class_name'] if 'class_name' in announcement.keys() else None
    section_name=announcement['section_name'] if 'section_name' in announcement.keys() else None
    if audience in ('class','section') and class_name:
        label=str(class_name)
        if audience=='section' and section_name: label+=' · Section '+str(section_name)
        return label
    return 'Whole academy'


def _announcement_cards(rows, today=None):
    """Decorate raw announcement rows for the read-only pages."""
    from datetime import date as _date, timedelta as _td
    today=today or _class_now().date()
    fresh_after=(today-_td(days=6)).isoformat()
    cards=[]
    for r in rows:
        card={k:r[k] for k in r.keys()}
        card['role_label']=ANNOUNCEMENT_ROLES.get(card.get('audience_role') or 'all','Everyone')
        card['scope_label']=announcement_scope_text(r)
        card['fresh']=str(card.get('created_at') or '')[:10]>=fresh_after
        cards.append(card)
    return cards


def visible_announcements(conn, user, limit=None):
    """Published announcements a signed-in person may see, newest first.

    Role targeting and class/section scoping are both applied here so the
    dashboards, the dedicated pages and the notifications can never disagree.
    """
    role=user['role']
    sql="SELECT a.* FROM announcements a WHERE a.status='published'"
    params=[]
    if role=='student': sql+=" AND a.audience_role IN ('all','students')"
    elif role=='parent': sql+=" AND a.audience_role IN ('all','parents')"
    elif role=='teacher': sql+=" AND a.audience_role IN ('all','teachers')"
    if role=='student':
        sql+=" AND (a.audience='all' OR (a.audience='class' AND a.class_name=?) OR (a.audience='section' AND a.class_name=? AND COALESCE(a.section_name,'')=COALESCE(?,'')))"
        params=[user['class_name'],user['class_name'],user['section_name']]
    elif role=='parent':
        # Any linked child can qualify the notice, not just the first one.
        sql+=""" AND (a.audience='all'
            OR (a.audience='class' AND a.class_name IN (SELECT s.class_name FROM parent_student_links l JOIN users s ON s.id=l.student_id WHERE l.parent_id=?))
            OR (a.audience='section' AND EXISTS (SELECT 1 FROM parent_student_links l JOIN users s ON s.id=l.student_id
                 WHERE l.parent_id=? AND s.class_name=a.class_name AND COALESCE(s.section_name,'')=COALESCE(a.section_name,''))))"""
        params=[user['id'],user['id']]
    elif role=='teacher':
        # Teachers also see notices aimed at a grade they actually teach.
        sql+=" AND (a.audience='all' OR a.class_name IN (SELECT DISTINCT s.grade FROM class_schedules s WHERE s.teacher_id=? AND s.active=1))"
        params=[user['id']]
    sql+=' ORDER BY a.id DESC'
    if limit: sql+=' LIMIT '+str(int(limit))
    return conn.execute(sql,tuple(params)).fetchall()


def mark_announcement_alerts_read(conn, user_id):
    """Opening the announcements page clears the related alerts for that person."""
    conn.execute("UPDATE notifications SET is_read=1,read_at=? WHERE user_id=? AND is_read=0 AND kind='announcement'",(iso_now(),user_id))


def deliver_announcement(conn, announcement):
    """Fan a published notice out to exactly the people it targets.

    Everything still goes through the existing notification centre; only the
    recipient list and the deep link differ per role.
    """
    role=announcement.get('audience_role') or 'all'
    scope=announcement.get('audience') or 'all'
    class_name=announcement.get('class_name'); section_name=announcement.get('section_name')
    title='Academy announcement: '+announcement['title']
    body=announcement['body']
    targets=[]
    student_scope="role='student' AND status='active'"
    if scope=='class': student_scope+=' AND class_name=?'; scope_params=(class_name,)
    elif scope=='section': student_scope+=" AND class_name=? AND COALESCE(section_name,'')=COALESCE(?,'')"; scope_params=(class_name,section_name)
    else: scope_params=()
    if role in ('all','students'):
        for row in conn.execute(f'SELECT id FROM users WHERE {student_scope}',scope_params).fetchall():
            targets.append((row['id'],'/announcements'))
    if role in ('all','parents'):
        parent_where="u.role='parent' AND u.status='active'"
        if scope=='class': parent_where+=' AND s.class_name=?'; parent_params=(class_name,)
        elif scope=='section': parent_where+=" AND s.class_name=? AND COALESCE(s.section_name,'')=COALESCE(?,'')"; parent_params=(class_name,section_name)
        else: parent_params=()
        parent_rows=conn.execute(f"""SELECT DISTINCT u.id FROM parent_student_links l JOIN users u ON u.id=l.parent_id
            JOIN users s ON s.id=l.student_id WHERE {parent_where}""",parent_params).fetchall()
        for row in parent_rows:
            targets.append((row['id'],'/parent/announcements'))
    if role in ('all','teachers'):
        if scope=='all':
            teacher_rows=conn.execute("SELECT id FROM users WHERE role='teacher' AND status='active'").fetchall()
        elif class_name:
            teacher_rows=conn.execute("""SELECT DISTINCT u.id FROM users u JOIN class_schedules s ON s.teacher_id=u.id
                WHERE u.role='teacher' AND u.status='active' AND s.active=1 AND s.grade=?""",(class_name,)).fetchall()
        else: teacher_rows=[]
        for row in teacher_rows:
            targets.append((row['id'],'/announcements'))
    for user_id,link in targets:
        if not _already_notified(conn,user_id,'announcement',None,title,body):
            notify(conn,user_id,title,body,kind='announcement',student_id=None,link_path=link)


def run_fee_notifications(conn, today=None):
    """Regenerate fee reminder and overdue notifications from the current fee
    records. Scan-generated alerts are idempotent: one per fee per kind."""
    from datetime import date as _date, timedelta
    today=today or _date.today()
    soon=today+timedelta(days=7)
    for fee in _fee_rows(conn):
        if fee['balance']<=0 or not fee['due_date']: continue
        student_id=fee['student_id']
        if fee['due_date']<today.isoformat():
            kind='fee_overdue'; title=f"Fee overdue: {fee['title']}"
            student_body=f"The {fee['title']} fee ({fee['currency']} {fee['balance']/100:.2f}) is past its due date of {fee['due_date']}. Open Fee Management to submit payment proof."
            parent_body=f"{fee['title']} is past its due date of {fee['due_date']} ({fee['currency']} {fee['balance']/100:.2f} outstanding). Open fee management to submit payment proof."
        else:
            if fee['due_date']>soon.isoformat(): continue
            if fee['submitted']: continue
            kind='fee_reminder'; title=f"Fee reminder: {fee['title']}"
            student_body=f"The {fee['title']} fee is due on {fee['due_date']} ({fee['currency']} {fee['balance']/100:.2f} outstanding). Open Fee Management to submit payment proof."
            parent_body=f"{fee['title']} is due on {fee['due_date']} ({fee['currency']} {fee['balance']/100:.2f} outstanding). Open fee management to submit payment proof."
        notify_student_and_parents(conn,student_id,kind,title,student_body,title,parent_body,
            student_link='/fees',parent_link=f"/parent/children/{student_id}/fees")

@app.middleware('http')
async def security_middleware(request: Request, call_next):
    if request.method not in {'GET','HEAD','OPTIONS'}:
        try:
            length=int(request.headers.get('content-length','0') or 0)
        except ValueError:
            length=0
        if length > MAX_POST_BYTES:
            return JSONResponse({'detail':'Request too large.'}, status_code=413)
    # Subject lists are memoised per request (see db.get_subjects); start each
    # request from a clean slate so an admin edit is visible immediately.
    clear_subjects_cache()
    # Pending applicants may use only the isolated demo and account status.
    # Enforce this before routing, including APIs, files and unsafe methods.
    path=request.url.path
    # The school logo remains public; student profile images require a signed-in,
    # active account. Applicants cannot bypass the demo gate by signing out.
    if path.startswith('/uploads/profile_'):
        viewer=current_user(request)
        if not viewer or viewer['status']!='active':
            return Response(status_code=404)
    if request.cookies.get('pms_session') and not (path.startswith('/static/') or path in {'/health','/logout','/explore','/admission/status'}):
        user=current_user(request)
        if user and user['role']=='student':
            with connect() as conn:
                admission=conn.execute('SELECT status FROM student_admissions WHERE user_id=?',(user['id'],)).fetchone()
            if admission and admission['status']!='approved':
                if request.method in {'GET','HEAD'}: return RedirectResponse('/admission/status',303)
                return JSONResponse({'detail':'Your application is awaiting review.'},status_code=403)
    response = await call_next(request)
    response.headers['X-Content-Type-Options']='nosniff'
    response.headers['X-Frame-Options']='DENY'
    response.headers['Referrer-Policy']='same-origin'
    response.headers['Permissions-Policy']='camera=(self "https://meet.jit.si"), microphone=(self "https://meet.jit.si"), display-capture=(self "https://meet.jit.si"), fullscreen=(self "https://meet.jit.si"), geolocation=()'
    response.headers['Content-Security-Policy']="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-src 'self' https://meet.jit.si; frame-ancestors 'none'; form-action 'self'"
    if os.getenv('PMS_SECURE_COOKIE','0')=='1':
        response.headers['Strict-Transport-Security']='max-age=31536000; includeSubDomains'
    if request.url.path not in {'/health'}:
        response.headers.setdefault('Cache-Control','no-store')
    return response

@app.exception_handler(401)
async def unauth(request, exc):
    path=request.url.path
    return RedirectResponse('/parent/login' if path=='/parent' or path.startswith('/parent/') else '/login', status_code=303)

@app.exception_handler(403)
async def forbidden(request, exc):
    if exc.detail == 'Security token expired. Refresh the page and try again.':
        message = 'Your security session expired or cookies are unavailable. Refresh the sign-in page and try again.'
        if request.url.path == '/register/academy':
            return JSONResponse({'detail': message}, status_code=403)
        return render(request,'error.html',{'code':403,'title':'Security session expired','message':message},403)
    return render(request,'error.html',{'code':403,'title':'Access denied','message':'You do not have permission to view this page.'},403)

@app.get('/', response_class=HTMLResponse)
def home(request: Request):
    u=current_user(request)
    if u:
        return RedirectResponse('/admin' if u['role']=='admin' else '/parent' if u['role']=='parent' else '/teacher' if u['role']=='teacher' else '/student',303)
    return render(request,'landing.html')

