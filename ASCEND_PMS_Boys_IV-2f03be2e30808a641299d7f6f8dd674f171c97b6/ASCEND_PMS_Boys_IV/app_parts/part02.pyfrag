@app.post('/login')
def login(request: Request, admission_no: str=Form(...), password: str=Form(...)):
    admission_no=admission_no.strip().upper()[:32]
    key=_attempt_key('login',request,admission_no); ip_key=_attempt_key('login-ip',request,'*')
    with connect() as conn:
        if _rate_limited(conn,key,8,15) or _rate_limited(conn,ip_key,30,15):
            return flash_redirect('/login','Too many sign-in attempts. Please wait 15 minutes and try again.','error')
        u=conn.execute('SELECT * FROM users WHERE admission_no=?',(admission_no,)).fetchone()
        if not u or not u['password_hash'] or not verify_password(password,u['password_hash']):
            _record_failure(conn,key); _record_failure(conn,ip_key)
            return flash_redirect('/login','Incorrect admission number or password.','error')
        if u['status']!='active':
            _record_failure(conn,key); _record_failure(conn,ip_key)
            return flash_redirect('/login','This account is not active. Please contact the school office.','error')
        _clear_failures(conn,key)
        token=new_token(); conn.execute('INSERT INTO sessions(token_hash,user_id,expires_at,created_at) VALUES (?,?,?,?)',
            (token_hash(token),u['id'],iso_expiry(),iso_now()))
    r=RedirectResponse('/admin' if u['role']=='admin' else '/student',303)
    r.set_cookie('pms_session',token,httponly=True,samesite='lax',secure=os.getenv('PMS_SECURE_COOKIE','0')=='1',max_age=7*24*3600)
    return r

@app.post('/register')
def register(request: Request, admission_no: str=Form(...), activation_code: str=Form(...), password: str=Form(...), confirm_password: str=Form(...)):
    s=settings()
    if s.get('registration_enabled')!='1': return flash_redirect('/register','Student registration is currently closed.','error')
    admission_no=admission_no.strip().upper()[:32]; activation_code=activation_code.strip().upper()[:32]
    key=_attempt_key('register',request,admission_no); ip_key=_attempt_key('register-ip',request,'*')
    if not ADMISSION_RE.match(admission_no): return flash_redirect('/register','Use a valid admission number, for example A-6738.','error')
    if password!=confirm_password: return flash_redirect('/register','Your passwords do not match.','error')
    if len(password)<8 or len(password)>128 or not re.search(r'[A-Za-z]',password) or not re.search(r'\d',password):
        return flash_redirect('/register','Password must be 8–128 characters and include letters and numbers.','error')
    with connect() as conn:
        if _rate_limited(conn,key,8,15) or _rate_limited(conn,ip_key,30,15):
            return flash_redirect('/register','Too many activation attempts. Please wait 15 minutes and try again.','error')
        u=conn.execute('SELECT * FROM users WHERE admission_no=?',(admission_no,)).fetchone()
        if not u or u['role']!='student' or u['claimed'] or (u['activation_code'] or '').upper()!=activation_code:
            _record_failure(conn,key); _record_failure(conn,ip_key)
            return flash_redirect('/register','We could not activate this account. Check the admission number and activation code, or contact the school administrator.','error')
        if u['activation_code_expires_at'] and u['activation_code_expires_at'] < _now().isoformat():
            _record_failure(conn,key); _record_failure(conn,ip_key)
            return flash_redirect('/register','This activation code has expired. Ask an administrator to issue a new one.','error')
        _clear_failures(conn,key)
        conn.execute('UPDATE users SET password_hash=?,claimed=1,status="active",activation_code=NULL,activation_code_expires_at=NULL WHERE id=?',(hash_password(password),u['id']))
        notify(conn,u['id'],'Welcome to ASCEND','Your account is active. Start completing challenges and climbing the leaderboards.')
    return flash_redirect('/login','Account created successfully. You can now sign in.')

@app.post('/logout')
def logout(request: Request):
    token=request.cookies.get('pms_session')
    if token:
        with connect() as conn: conn.execute('DELETE FROM sessions WHERE token_hash=?',(token_hash(token),))
    r=RedirectResponse('/login',303); r.delete_cookie('pms_session'); return r

