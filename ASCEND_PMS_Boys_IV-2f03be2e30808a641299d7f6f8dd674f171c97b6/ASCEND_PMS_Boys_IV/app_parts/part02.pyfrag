def explore_page(request: Request):
    # A standalone demonstration: no student data or live writes are loaded.
    return render(request,'explore.html')

@app.get('/about', response_class=HTMLResponse)
def about_page(request: Request):
    return render(request,'about.html')

@app.get('/privacy', response_class=HTMLResponse)
def privacy_page(request: Request):
    return render(request,'privacy.html')

@app.get('/login', response_class=HTMLResponse)
def login_page(request: Request): return render(request,'auth.html',{'mode':'login'})

@app.get('/parent/login', response_class=HTMLResponse)
def parent_login_page(request: Request):
    # The shared layout is the authenticated workspace when a session exists.
    user=current_user(request)
    if user and user['status']=='active':
        return RedirectResponse('/admin' if user['role']=='admin' else '/parent' if user['role']=='parent' else '/teacher' if user['role']=='teacher' else '/student',303)
    # A disabled account's session cannot access the workspace.
    if user: request.state.current_user=None
    return render(request,'auth.html',{'mode':'parent_login'})

@app.get('/register', response_class=HTMLResponse)
def register_page(request: Request):
    # The mascot-guided wizard is the one and only way to join the academy.
    # It is a prebuilt single-file bundle served from /static so the CSP stays
    # 'self' only; it posts to /admission/register below.
    if settings().get('registration_enabled') != '1':
        return render(request,'registration_closed.html')
    page = (BASE_DIR / 'static' / 'academy-signup' / 'index.html').read_text(encoding='utf-8')
    csrf = request.cookies.get('pms_csrf') or new_token(24)
    response = HTMLResponse(page)
    if not request.cookies.get('pms_csrf'):
        set_app_cookie(response, 'pms_csrf', csrf)
    return response

@app.get('/register/legacy')
def legacy_register_page(request: Request):
    # The activation-code claim flow has been retired; send old links to the
    # wizard rather than 404 so any bookmarked URL still works.
    return RedirectResponse('/register', status_code=301)

@app.post('/login')
def login(request: Request, admission_no: str=Form(...), password: str=Form(...)):
    return _sign_in(request,admission_no,password)

@app.post('/parent/login')
def parent_login(request: Request, admission_no: str=Form(...), password: str=Form(...)):
    return _sign_in(request,admission_no,password,parent_only=True)

def _sign_in(request: Request, admission_no: str, password: str, parent_only: bool=False):
    login_path='/parent/login' if parent_only else '/login'
    admission_no=admission_no.strip().upper()[:32]
    key=_attempt_key('login',request,admission_no); ip_key=_attempt_key('login-ip',request,'*')
    with connect() as conn:
        # Serialize parent sign-ins with password reset/disable, including sign-in
        # through the existing shared form, so old credentials cannot create a
        # new session after an administrator has revoked them.
        if parent_only or admission_no.startswith('P-'): conn.execute('BEGIN IMMEDIATE')
        if _rate_limited(conn,key,8,15) or _rate_limited(conn,ip_key,30,15):
            return flash_redirect(login_path,'Too many sign-in attempts. Please wait 15 minutes and try again.','error')
        u=conn.execute('SELECT * FROM users WHERE admission_no=?',(admission_no,)).fetchone()
        if not u and admission_no.startswith('TMP-'):
            u=conn.execute('SELECT u.* FROM users u JOIN student_admissions a ON a.user_id=u.id WHERE a.temporary_id=?',(admission_no,)).fetchone()
        no_password=bool(u and not u['password_hash'])
        if no_password or not u or not verify_password(password,u['password_hash'] or '') or (parent_only and (u['role']!='parent' or not admission_no.startswith('P-'))):
            _record_failure(conn,key); _record_failure(conn,ip_key)
            if no_password:
                return flash_redirect(login_path,'This account has no password yet. Ask the academy office to set one for you.','error')
            if not u:
                # Zero and the letter O look alike on printed IDs. Point to the
                # stored spelling instead of leaving a confusing password error.
                swapped=admission_no.translate(str.maketrans('O0','0O'))
                if swapped!=admission_no:
                    near=conn.execute('SELECT admission_no FROM users WHERE admission_no=?',(swapped,)).fetchone()
                    if near: return flash_redirect(login_path,f'No account matches that ID. Did you mean {near["admission_no"]}?','error')
            return flash_redirect(login_path,'Incorrect parent ID or password.' if parent_only else 'Incorrect admission number or password.','error')
        pending_admission=conn.execute("SELECT status FROM student_admissions WHERE user_id=?",(u['id'],)).fetchone() if u['role']=='student' else None
        # A disabled account cannot sign in. A rejected applicant is disabled by
        # design, so the decision is communicated by the academy office rather
        # than by reopening the account.
        if u['status']!='active' and not (u['status']=='pending' and pending_admission and pending_admission['status']=='pending'):
            _record_failure(conn,key); _record_failure(conn,ip_key)
            return flash_redirect(login_path,'This account is not active. Please contact the academy office.','error')
        _clear_failures(conn,key)
        token=new_token(); conn.execute('INSERT INTO sessions(token_hash,user_id,expires_at,created_at) VALUES (?,?,?,?)',
            (token_hash(token),u['id'],iso_expiry(),iso_now()))
        # Guardian sign-ins are recorded for academy oversight (Super Admin).
        # Only successful sign-ins are logged, and never passwords or tokens.
        if u['role']=='parent':
            audit(conn,None,'parent_signed_in',f"{u['admission_no']} · {u['full_name']}")
    destination='/admission/status' if pending_admission and (pending_admission['status']=='pending' or admission_no.startswith('TMP-')) else ('/admin' if u['role']=='admin' else '/parent' if u['role']=='parent' else '/teacher' if u['role']=='teacher' else '/student')
    r=RedirectResponse(destination,303)
    set_app_cookie(r,'pms_session',token,httponly=True)
    return r

@app.post('/register')
def register_legacy(request: Request):
    # Old clients cannot skip the academy profile and grade validation.
    return flash_redirect('/register','Please complete the academy registration form.','error')

@app.post('/register/academy')
def academy_register(request: Request, profile: str=Form(...)):
    def fail(message, status=400):
        return JSONResponse({'detail': message}, status_code=status)

    if settings().get('registration_enabled') != '1':
        return fail('Student registration is currently closed.')
    try:
        data = json.loads(profile)
        if not isinstance(data, dict): raise ValueError()
        required = ('fullName', 'email', 'phone', 'schoolName', 'gender', 'dob', 'guardianName', 'guardianPhone',
                    'country', 'province', 'program', 'schoolRegion', 'schoolType', 'grade',
                    'admissionNo', 'activationCode', 'password', 'confirmPassword')
        optional = ('countryCode', 'section')
        for name in required + optional:
            value = data.get(name, '')
            if not isinstance(value, str) or len(value) > (128 if name in ('password', 'confirmPassword') else 200):
                raise ValueError()
            if name in required and not value.strip(): raise ValueError()
        if not re.fullmatch(r'[^\s@]+@[^\s@]+\.[^\s@]+', data['email'].strip()): raise ValueError()
        dob = datetime.strptime(data['dob'], '%Y-%m-%d').date()
        if dob > _now().date(): raise ValueError()
        if data['gender'] not in ('Female', 'Male', 'Non-binary', 'Prefer not to say'): raise ValueError()
        if data['schoolType'] not in ('Public', 'Private', 'International', 'Cambridge Centre'): raise ValueError()
        grades = {'O-Level': ('O-Level - Grade 9', 'O-Level - Grade 10', 'O-Level - Grade 11'),
                  'A-Level': ('A-Level - AS (Grade 12)', 'A-Level - A2 (Grade 13)')}
        if data['program'] not in grades or data['grade'] not in grades[data['program']]: raise ValueError()
        subjects = data.get('subjects')
        allowed_subjects = get_subjects()
        if not isinstance(subjects, list) or not subjects or any(x not in allowed_subjects for x in subjects): raise ValueError()
        if data.get('terms') is not True: raise ValueError()
    except (ValueError, TypeError, json.JSONDecodeError):
        return fail('Please check your registration details and try again.')
    admission_no = data['admissionNo'].strip().upper()
    code = data['activationCode'].strip().upper()
    password = data['password']
    if not ADMISSION_RE.fullmatch(admission_no):
        return fail('Use a valid admission number, for example A-6738.')
    if password != data['confirmPassword']:
        return fail('Your passwords do not match.')
    if len(password) < 8 or not re.search(r'[A-Za-z]', password) or not re.search(r'\d', password):
        return fail('Password must be 8–128 characters and include letters and numbers.')
    key = _attempt_key('register', request, admission_no)
    ip_key = _attempt_key('register-ip', request, '*')
    with connect() as conn:
        # Serialize code redemption so two requests cannot activate the same account.
        conn.execute('BEGIN IMMEDIATE')
        if _rate_limited(conn, key, 8, 15) or _rate_limited(conn, ip_key, 30, 15):
            return fail('Too many activation attempts. Please wait 15 minutes and try again.', 429)
        u = conn.execute('SELECT * FROM users WHERE admission_no=?', (admission_no,)).fetchone()
        if not u or u['role'] != 'student' or u['status'] != 'unclaimed' or u['claimed'] or not u['activation_code'] or not hmac.compare_digest(u['activation_code'].upper().encode('utf-8'), code.encode('utf-8')):
            _record_failure(conn, key); _record_failure(conn, ip_key)
            return fail('We could not activate this account. Check the admission number and activation code, or contact the academy administrator.')
        if u['activation_code_expires_at'] and u['activation_code_expires_at'] < _now().isoformat():
            _record_failure(conn, key); _record_failure(conn, ip_key)
            return fail('This activation code has expired. Ask an administrator to issue a new one.')
        _clear_failures(conn, key)
        conn.execute('UPDATE users SET password_hash=?,full_name=?,class_name=?,section_name=?,claimed=1,status="active",activation_code=NULL,activation_code_expires_at=NULL WHERE id=?', (hash_password(password), data['fullName'].strip(), data['grade'].strip(), data.get('section', '').strip(), u['id']))
        # Keep submitted profile details separately from the school-managed student record.
        saved = {name: data.get(name, '').strip() for name in ('fullName', 'email', 'phone', 'countryCode', 'gender', 'dob', 'guardianName', 'guardianPhone', 'country', 'province', 'program', 'schoolName', 'schoolRegion', 'schoolType', 'grade', 'section')}
        saved['subjects'] = subjects
        conn.execute('INSERT INTO academy_signup_profiles(user_id,profile_json,created_at) VALUES (?,?,?) ON CONFLICT(user_id) DO UPDATE SET profile_json=excluded.profile_json,created_at=excluded.created_at', (u['id'], json.dumps(saved), iso_now()))
        notify(conn, u['id'], 'Welcome to ASCEND', 'Your account is active. Start completing challenges and climbing the leaderboards.')
        token = new_token()
        conn.execute('INSERT INTO sessions(token_hash,user_id,expires_at,created_at) VALUES (?,?,?,?)', (token_hash(token), u['id'], iso_expiry(), iso_now()))
    response = JSONResponse({'redirect': '/student'})
    set_app_cookie(response,'pms_session',token,httponly=True)
    return response

@app.post('/logout')
def logout(request: Request):
    token=request.cookies.get('pms_session')
    if token:
        with connect() as conn: conn.execute('DELETE FROM sessions WHERE token_hash=?',(token_hash(token),))
    r=RedirectResponse('/login',303); set_app_cookie(r,'pms_session','',httponly=True,max_age=0); return r

