uest.cookies.get('pms_csrf') or new_token(24)
    context.update({'request':request,'settings':settings(),'user':current_user(request),
                    'msg':request.query_params.get('msg'),'kind':request.query_params.get('kind','success'),
                    'csrf_token':csrf,
                    'is_super_admin':is_super_admin(current_user(request)),
                    'admin_permissions':_admin_permissions(current_user(request)),
                    'staff_permission_labels':STAFF_PERMISSION_LABELS,
                    'app_version':APP_VERSION})
    response = templates.TemplateResponse(request=request, name=name, context=context, status_code=status_code)
    if not request.cookies.get('pms_csrf'):
        response.set_cookie('pms_csrf',csrf,httponly=False,samesite='lax',
                            secure=os.getenv('PMS_SECURE_COOKIE','0')=='1',max_age=7*24*3600)
    return response

def total_points(conn, user_id, category=None, since=None):
    q='SELECT COALESCE(SUM(amount),0) AS total FROM point_transactions WHERE user_id=?'; args=[user_id]
    if category and category!='overall': q+=' AND category=?'; args.append(category)
    if since: q+=' AND created_at>=?'; args.append(since)
    return conn.execute(q,args).fetchone()['total']

def sync_achievements(conn, user_id):
    achievements=conn.execute('SELECT * FROM achievements WHERE status="active" ORDER BY points_required').fetchall()
    for ach in achievements:
        category=ach['category']
        points=total_points(conn,user_id,None if category=='overall' else category)
        if points >= ach['points_required']:
            exists=conn.execute('SELECT 1 FROM student_achievements WHERE achievement_id=? AND user_id=?',(ach['id'],user_id)).fetchone()
            if not exists:
                conn.execute('INSERT INTO student_achievements(achievement_id,user_id,unlocked_at) VALUES (?,?,?)',(ach['id'],user_id,iso_now()))
                notify(conn,user_id,'Achievement unlocked',f'You unlocked {ach["name"]}.')

def audit(conn, admin_id, action, details=''):
    conn.execute('INSERT INTO audit_logs(admin_id,action,details,created_at) VALUES (?,?,?,?)',
                 (admin_id,action,details,iso_now()))

def notify(conn, user_id, title, body):
    conn.execute('INSERT INTO notifications(user_id,title,body,created_at) VALUES (?,?,?,?)',
                 (user_id,title,body,iso_now()))

@app.middleware('http')
async def security_middleware(request: Request, call_next):
    if request.method not in {'GET','HEAD','OPTIONS'}:
        try:
            length=int(request.headers.get('content-length','0') or 0)
        except ValueError:
            length=0
        if length > MAX_POST_BYTES:
            return JSONResponse({'detail':'Request too large.'}, status_code=413)
    response = await call_next(request)
    response.headers['X-Content-Type-Options']='nosniff'
    response.headers['X-Frame-Options']='DENY'
    response.headers['Referrer-Policy']='same-origin'
    response.headers['Permissions-Policy']='camera=(), microphone=(), geolocation=()'
    response.headers['Content-Security-Policy']="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    if os.getenv('PMS_SECURE_COOKIE','0')=='1':
        response.headers['Strict-Transport-Security']='max-age=31536000; includeSubDomains'
    if request.url.path not in {'/health'}:
        response.headers.setdefault('Cache-Control','no-store')
    return response

@app.exception_handler(401)
async def unauth(request, exc):
    return RedirectResponse('/login', status_code=303)

@app.exception_handler(403)
async def forbidden(request, exc):
    return render(request,'error.html',{'code':403,'title':'Access denied','message':'You do not have permission to view this page.'},403)

@app.get('/', response_class=HTMLResponse)
def home(request: Request):
    u=current_user(request)
    if u:
        return RedirectResponse('/admin' if u['role']=='admin' else '/student',303)
    return render(request,'landing.html')

