    return _report_pdf(request,student_id,period,term_id)

@app.get('/admin/teachers',response_class=HTMLResponse)
def teacher_accounts(request:Request):
    require_admin(request,super_only=True)
    with connect() as conn:
        teachers=conn.execute("SELECT id,admission_no,full_name,status FROM users WHERE role='teacher' ORDER BY full_name,id").fetchall()
    return render(request,'admin_teachers.html',{'teachers':teachers})

@app.post('/admin/teachers/create')
def teacher_account_create(request:Request,teacher_id:str=Form(...),full_name:str=Form(...),password:str=Form(...)):
    admin=require_admin(request,super_only=True)
    try:
        teacher_id=teacher_id.strip().upper()
        if not re.fullmatch(r'T-[A-Z0-9]{3,20}',teacher_id): raise ValueError('Use a teacher ID such as T-1234.')
        full_name=_clean_text(full_name,120)
        if not _validate_password_strength(password): raise ValueError('Password must be 12–128 characters and include letters and numbers.')
        with connect() as conn:
            conn.execute('BEGIN IMMEDIATE')
            conn.execute("INSERT INTO users(admission_no,full_name,password_hash,role,status,claimed,created_at) VALUES (?,?,?,'teacher','active',1,?)",(teacher_id,full_name,hash_password(password),iso_now()))
            audit(conn,admin['id'],'teacher_account_created',teacher_id)
    except (ValueError,TypeError)+INTEGRITY_ERRORS as exc:
        return flash_redirect('/admin/teachers',str(exc) if isinstance(exc,ValueError) else 'That account ID is already in use.','error')
    return flash_redirect('/admin/teachers','Teacher account created. Share the credentials securely.')

@app.post('/admin/teachers/{teacher_id}/update')
def teacher_account_update(request:Request,teacher_id:int,full_name:str=Form(...),status:str=Form(...)):
    admin=require_admin(request,super_only=True)
    try:
        full_name=_clean_text(full_name,120)
        if status not in ('active','disabled'): raise ValueError('Invalid status.')
        with connect() as conn:
            conn.execute('BEGIN IMMEDIATE')
            changed=conn.execute("UPDATE users SET full_name=?,status=? WHERE id=? AND role='teacher'",(full_name,status,teacher_id))
            if not changed.rowcount: raise HTTPException(404)
            if status=='disabled': conn.execute('DELETE FROM sessions WHERE user_id=?',(teacher_id,))
            audit(conn,admin['id'],'teacher_account_updated',f'Teacher {teacher_id}; status {status}')
    except ValueError as exc: return flash_redirect('/admin/teachers',str(exc),'error')
    return flash_redirect('/admin/teachers','Teacher account updated.')

@app.post('/admin/teachers/{teacher_id}/password')
def teacher_account_reset(request:Request,teacher_id:int,password:str=Form(...)):
    admin=require_admin(request,super_only=True)
    if not _validate_password_strength(password): return flash_redirect('/admin/teachers','Password must be 12–128 characters and include letters and numbers.','error')
    with connect() as conn:
        conn.execute('BEGIN IMMEDIATE')
        result=conn.execute("UPDATE users SET password_hash=? WHERE id=? AND role='teacher'",(hash_password(password),teacher_id))
        if not result.rowcount: raise HTTPException(404)
        conn.execute('DELETE FROM sessions WHERE user_id=?',(teacher_id,)); audit(conn,admin['id'],'teacher_password_reset',f'Teacher {teacher_id}')
    return flash_redirect('/admin/teachers','Password reset and teacher sessions signed out.')

@app.get('/teacher',response_class=HTMLResponse)
def teacher_home(request:Request):
    teacher=require_user(request,'teacher')
    with connect() as conn: assignments=_teacher_assignments(conn,teacher['id'])
    return render(request,'teacher_home.html',{'assignments':assignments})

@app.get('/admin/teaching/classes',response_class=HTMLResponse)
@app.get('/teacher/classes',response_class=HTMLResponse)
def teacher_classes(request:Request):
    teacher,_=_progress_actor(request)
    with connect() as conn:
        all_schedules=_schedules(conn); students=_class_students(conn); today=_class_now().date()
        schedules=[s for s in all_schedules if s['teacher_id']==teacher['id']]
        started={r['schedule_id'] for r in conn.execute('SELECT schedule_id FROM class_sessions WHERE session_date=? AND teacher_id=?',(today.isoformat(),teacher['id'])).fetchall()}
        rows=[dict(s,members=_members(s,students,all_schedules),day_label=_day_label(s),end_time=_end_time(s),due=_due_today(s,today),started=s['id'] in started) for s in schedules]
        sessions=[dict(r) for r in conn.execute('SELECT * FROM class_sessions WHERE teacher_id=? ORDER BY id DESC LIMIT 100',(teacher['id'],)).fetchall()]
        assignments=_teacher_assignments(conn,teacher['id'])
        roster_by_session={s['id']:[] for s in sessions}
        if sessions:
            ids=list(roster_by_session); q=','.join('?' for _ in ids)
            roster=conn.execute('''SELECT a.session_id,a.student_id,a.status,u.full_name,u.admission_no FROM class_attendance a JOIN users u ON u.id=a.student_id
                WHERE a.session_id IN ('''+q+''') ORDER BY u.full_name,u.id''',ids).fetchall()
            subjects_by_session={s['id']:s['subject'] for s in sessions}
            for r in roster:
                if r['student_id'] in assignments and subjects_by_session[r['session_id']] in assignments[r['student_id']]['subjects']:
                    roster_by_session[r['session_id']].append(r)
        for session in sessions: session['roster']=roster_by_session[session['id']]
    return render(request,'teacher_classes.html',{'rows':rows,'sessions':sessions,'today':today.isoformat(),'classes_root':'/teacher/classes' if teacher['role']=='teacher' else '/admin/teaching/classes','student_root':'/teacher/students' if teacher['role']=='teacher' else '/admin/teaching/students'})

@app.get('/teacher/students/{student_id}',response_class=HTMLResponse)
@app.get('/admin/teaching/students/{student_id}',response_class=HTMLResponse)
def teacher_student_profile(request:Request,student_id:int):
    teacher,target=_progress_actor(request)
    with connect() as conn:
        assignment=_teacher_assignments(conn,teacher['id']).get(student_id)
        if not assignment: raise HTTPException(404)
        attendance=conn.execute("""SELECT s.session_date,s.subject,a.status FROM class_attendance a JOIN class_sessions s ON s.id=a.session_id
            WHERE a.student_id=? AND s.teacher_id=? AND s.status='ended' ORDER BY s.session_date DESC,s.id DESC""",(student_id,teacher['id'])).fetchall()
        attendance=[r for r in attendance if r['subject'] in assignment['subjects']]
        records=conn.execute('SELECT * FROM student_progress_records WHERE student_id=? AND teacher_id=? ORDER BY record_date DESC,id DESC',(student_id,teacher['id'])).fetchall()
        records=[r for r in records if r['subject'] in assignment['subjects']]
    return render(request,'teacher_student.html',{'assignment':assignment,'attendance':attendance,'records':records,'teaching_root':target,'feedback_labels':FEEDBACK_LABELS})

@app.get('/teacher/account',response_class=HTMLResponse)
def teacher_own_account(request:Request):
    require_user(request,'teacher')
    return render(request,'teacher_account.html')

@app.post('/teacher/account/password')
def teacher_own_password(request:Request,current_password:str=Form(...),new_password:str=Form(...),confirm_password:str=Form(...)):
    teacher=require_user(request,'teacher')
    if new_password!=confirm_password: return flash_redirect('/teacher/account','Passwords do not match.','error')
    if not _validate_password_strength(new_password): return flash_redirect('/teacher/account','Password must be 12–128 characters and include letters and numbers.','error')
    if not teacher['password_hash'] or not verify_password(current_password,teacher['password_hash']): return flash_redirect('/teacher/account','Current password is incorrect.','error')
    with connect() as conn:
        conn.execute('BEGIN IMMEDIATE')
        conn.execute("UPDATE users SET password_hash=? WHERE id=? AND role='teacher'",(hash_password(new_password),teacher['id']))
        conn.execute('DELETE FROM sessions WHERE user_id=? AND token_hash!=?',(teacher['id'],token_hash(request.cookies.get('pms_session',''))))
    return flash_redirect('/teacher/account','Password updated. Other sessions have been signed out.')


@app.get('/admin/holidays',response_class=HTMLResponse)
def holiday_admin(request:Request):
    require_admin(request,super_only=True)
    with connect() as conn:
        holidays=conn.execute('SELECT holiday_date,title FROM academy_holidays ORDER BY holiday_date DESC').fetchall()
    return render(request,'admin_holidays.html',{'holidays':holidays})

@app.post('/admin/holidays')
def holiday_save(request:Request,holiday_date:str=Form(...),title:str=Form(...)):
    admin=require_admin(request,super_only=True)
    try:
        if not re.fullmatch(r'\d{4}-\d{2}-\d{2}',holiday_date): raise ValueError('Choose a valid date.')
        value=date.fromisoformat(holiday_date)
        if not 1900<=value.year<=2100: raise ValueError('Choose a date between 1900 and 2100.')
        title=_clean_text(title,120)
        with connect() as conn:
            conn.execute('BEGIN IMMEDIATE')
            conn.execute('INSERT INTO academy_holidays(holiday_date,title,created_by,created_at) VALUES (?,?,?,?) ON CONFLICT(holiday_date) DO UPDATE SET title=excluded.title,created_by=excluded.created_by,created_at=excluded.created_at',(holiday_date,title,admin['id'],iso_now()))
            audit(conn,admin['id'],'holiday_saved',holiday_date)
    except ValueError as exc: return flash_redirect('/admin/holidays',str(exc),'error')
    return flash_redirect('/admin/holidays','Holiday saved. Existing attendance records are unchanged.')

@app.post('/admin/holidays/remove')
def holiday_remove(request:Request,holiday_date:str=Form(...)):
    admin=require_admin(request,super_only=True)
    with connect() as conn:
        conn.execute('BEGIN IMMEDIATE')
        result=conn.execute('DELETE FROM academy_holidays WHERE holiday_date=?',(holiday_date,))
        if result.rowcount: audit(conn,admin['id'],'holiday_removed',holiday_date)
    return flash_redirect('/admin/holidays','Holiday removed. Existing attendance records are unchanged.')
