@app.post('/admin/reward-claims/{claim_id}/status')
def admin_reward_claim(request: Request,claim_id:int,status:str=Form(...)):
    a=require_admin(request,'rewards')
    if status not in {'pending','approved','rejected','fulfilled'}: return flash_redirect('/admin/rewards','Invalid status.','error')
    with connect() as conn:
        # Reserve finite stock atomically when a claim is approved or fulfilled.
        conn.execute('BEGIN IMMEDIATE')
        row=conn.execute('SELECT * FROM reward_claims WHERE id=?',(claim_id,)).fetchone()
        if row:
            reward=conn.execute('SELECT quantity FROM rewards WHERE id=?',(row['reward_id'],)).fetchone()
            if status in {'approved','fulfilled'} and row['status'] not in {'approved','fulfilled'} and reward and reward['quantity'] is not None:
                reserved=conn.execute("SELECT COUNT(*) c FROM reward_claims WHERE reward_id=? AND status IN ('approved','fulfilled')",(row['reward_id'],)).fetchone()['c']
                if reserved >= reward['quantity']: return flash_redirect('/admin/rewards','This reward is out of stock.','error')
            if row['status'] != status:
                conn.execute('UPDATE reward_claims SET status=? WHERE id=?',(status,claim_id)); notify(conn,row['user_id'],'Reward claim updated',f'Your reward claim is now {status}.'); audit(conn,a['id'],'reward_claim_updated',f'{claim_id}->{status}')
    return flash_redirect('/admin/rewards','Claim updated.')

