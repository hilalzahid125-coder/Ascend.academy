@app.post('/admin/settings')
def admin_settings_save(request: Request,school_name:str=Form(...),app_name:str=Form(...),tagline:str=Form(...),creator_credit:str=Form(...),registration_enabled:Optional[str]=Form(None)):
    a=require_admin(request,super_only=True)
    try:
        school_name=_clean_text(school_name,160); app_name=_clean_text(app_name,80); tagline=_clean_text(tagline,160); creator_credit=_clean_text(creator_credit,160)
    except ValueError as exc: return flash_redirect('/admin/settings',str(exc),'error')
    vals={'school_name':school_name,'app_name':app_name,'tagline':tagline,'creator_credit':creator_credit,'registration_enabled':'1' if registration_enabled else '0'}
    with connect() as conn:
        for k,v in vals.items(): conn.execute('INSERT INTO settings(key,value) VALUES (?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',(k,v))
        audit(conn,a['id'],'settings_updated',json.dumps(vals))
    return flash_redirect('/admin/settings','Branding and registration settings saved.')

@app.post('/admin/settings/logo')
async def admin_logo_upload(request: Request, logo: UploadFile=File(...)):
    a=require_admin(request,super_only=True)
    ext=Path(logo.filename or '').suffix.lower()
    if ext not in {'.png','.jpg','.jpeg','.webp'}:
        return flash_redirect('/admin/settings','Please upload a PNG, JPG, or WEBP image. SVG uploads are disabled for security.','error')
    data=await logo.read()
    if len(data)>2_000_000: return flash_redirect('/admin/settings','Logo must be under 2 MB.','error')
    try:
        from PIL import Image
        Image.MAX_IMAGE_PIXELS=20_000_000
        image=Image.open(io.BytesIO(data)); image.verify()
        image=Image.open(io.BytesIO(data))
        if image.width>4000 or image.height>4000: return flash_redirect('/admin/settings','Logo dimensions are too large.','error')
        if image.mode not in {'RGB','RGBA'}: image=image.convert('RGBA')
        out=io.BytesIO()
        image.save(out,'PNG',optimize=True)
        save_upload('school_logo.png',out.getvalue(),'image/png')
    except Exception:
        return flash_redirect('/admin/settings','That file is not a valid supported image.','error')
    with connect() as conn:
        conn.execute('INSERT INTO settings(key,value) VALUES ("school_logo_path",?) ON CONFLICT(key) DO UPDATE SET value=excluded.value',('/uploads/school_logo.png',)); audit(conn,a['id'],'school_logo_updated','school_logo.png')
    return flash_redirect('/admin/settings','School logo updated.')

