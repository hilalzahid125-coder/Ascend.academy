(request: Request):
    a=require_admin(request)
    if is_super_admin(a):
        return a
    if not ({'students','challenges'} & _admin_permissions(a)):
        raise HTTPException(status_code=403)
    return a

@app.get('/admin/reports', response_class=HTMLResponse)
def admin_reports(request: Request):
    a=_require_reports_access(request)
    perms=_admin_permissions(a)
    with connect() as conn:
        stats={
            'students':conn.execute('SELECT COUNT(*) c FROM users WHERE role="student"').fetchone()['c'],
            'active_students':conn.execute('SELECT COUNT(*) c FROM users WHERE role="student" AND status="active"').fetchone()['c'],
            'points':conn.execute('SELECT COALESCE(SUM(amount),0) c FROM point_transactions').fetchone()['c'],
            'participations':conn.execute('SELECT COUNT(*) c FROM challenge_participations').fetchone()['c'],
            'pending':conn.execute('SELECT COUNT(*) c FROM challenge_participations WHERE status="pending"').fetchone()['c'],
        }
        top=conn.execute('''SELECT u.full_name,u.admission_no,u.class_name,u.section_name,COALESCE(SUM(p.amount),0) points
                            FROM users u LEFT JOIN point_transactions p ON p.user_id=u.id
                            WHERE u.role='student' GROUP BY u.id ORDER BY points DESC,u.full_name LIMIT 8''').fetchall()
    return render(request,'admin_reports.html',{'stats':stats,'top':top,'report_permissions':perms})

@app.get('/admin/reports/students.csv')
def admin_students_report_csv(request: Request):
    require_admin(request,'students')
    with connect() as conn:
        rows=conn.execute('''SELECT u.admission_no,u.full_name,u.class_name,u.section_name,u.status,u.claimed,
            COALESCE(SUM(p.amount),0) total_points,
            COALESCE(SUM(CASE WHEN p.category='academic' THEN p.amount ELSE 0 END),0) academic_points,
            COALESCE(SUM(CASE WHEN p.category='sports' THEN p.amount ELSE 0 END),0) sports_points,
            COALESCE(SUM(CASE WHEN p.category='character' THEN p.amount ELSE 0 END),0) character_points,
            COALESCE(SUM(CASE WHEN p.category='activity' THEN p.amount ELSE 0 END),0) activity_points
            FROM users u LEFT JOIN point_transactions p ON p.user_id=u.id
            WHERE u.role='student' GROUP BY u.id ORDER BY total_points DESC,u.full_name''').fetchall()
    out=io.StringIO(); w=csv.writer(out)
    w.writerow(['Admission Number','Full Name','Class','Section','Account Status','Activated','Total Points','Academic','Sports','Character','Activity'])
    for r in rows:
        w.writerow([_csv_safe(r['admission_no']),_csv_safe(r['full_name']),_csv_safe(r['class_name']),_csv_safe(r['section_name']),
                    _csv_safe(r['status']),'Yes' if r['claimed'] else 'No',r['total_points'],r['academic_points'],r['sports_points'],r['character_points'],r['activity_points']])
    return Response(out.getvalue(),media_type='text/csv',headers={'Content-Disposition':'attachment; filename="ascend_student_points_report.csv"'})

@app.get('/admin/reports/challenges.csv')
def admin_challenges_report_csv(request: Request):
    require_admin(request,'challenges')
    with connect() as conn:
        rows=conn.execute('''SELECT c.title,c.category,c.status challenge_status,c.points,u.admission_no,u.full_name,u.class_name,u.section_name,
                                    cp.status participation_status,cp.awarded,cp.created_at,cp.updated_at
                             FROM challenge_participations cp
                             JOIN challenges c ON c.id=cp.challenge_id JOIN users u ON u.id=cp.user_id
                             ORDER BY c.id DESC,cp.id DESC''').fetchall()
    out=io.StringIO(); w=csv.writer(out)
    w.writerow(['Challenge','Category','Challenge Status','Points','Admission Number','Student','Class','Section','Participation Status','Points Awarded','Joined At','Updated At'])
    for r in rows:
        w.writerow([_csv_safe(r['title']),_csv_safe(r['category']),_csv_safe(r['challenge_status']),r['points'],_csv_safe(r['admission_no']),
                    _csv_safe(r['full_name']),_csv_safe(r['class_name']),_csv_safe(r['section_name']),_csv_safe(r['participation_status']),
                    'Yes' if r['awarded'] else 'No',_csv_safe(r['created_at']),_csv_safe(r['updated_at'])])
    return Response(out.getvalue(),media_type='text/csv',headers={'Content-Disposition':'attachment; filename="ascend_challenge_report.csv"'})

@app.get('/admin/students', response_class=HTMLResponse)
def admin_students(request: Request):
    require_admin(request,'students')
    with connect() as conn:
        rows=conn.execute('''SELECT u.*, sp.profile_json, COALESCE(SUM(p.amount),0) points FROM users u
                             LEFT JOIN academy_signup_profiles sp ON sp.user_id=u.id
                             LEFT JOIN point_transactions p ON p.user_id=u.id
                             WHERE u.role='student' GROUP BY u.id,sp.profile_json ORDER BY u.id DESC''').fetchall()
        students=[]
        for row in rows:
            item=dict(row); item['academy_profile']=academy_profile_from_row(row); students.append(item)
    return render(request,'admin_students.html',{'students':students,'academy_grades':ACADEMY_GRADES})

