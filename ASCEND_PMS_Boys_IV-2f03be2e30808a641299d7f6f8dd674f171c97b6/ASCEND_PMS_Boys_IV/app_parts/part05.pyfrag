    return Response(out.getvalue(),media_type='text/csv',headers={'Content-Disposition':'attachment; filename="ascend_activation_codes.csv"'})

@app.post('/admin/students/import')
async def admin_students_import(request: Request, roster: UploadFile=File(...)):
    a=require_admin(request,'students')
    data=await roster.read()
    if len(data)>2_500_000:
        return flash_redirect('/admin/students','Roster file must be under 2.5 MB.','error')
    try:
        source_rows=_parse_roster_bytes(roster.filename or '',data)
    except Exception as exc:
        return flash_redirect('/admin/students',f'Could not read roster: {str(exc)[:160]}','error')
    if not source_rows:
        return flash_redirect('/admin/students','The roster file contained no student rows.','error')
    if len(source_rows)>2500:
        return flash_redirect('/admin/students','Import is limited to 2,500 students at a time.','error')
    created=[]; errors=[]; seen=set()
    with connect() as conn:
        existing={r['admission_no'] for r in conn.execute('SELECT admission_no FROM users').fetchall()}
        for idx,row in enumerate(source_rows,start=2):
            adm=str(row.get('admission_no') or '').strip().upper()
            name=str(row.get('full_name') or '').strip()
            cl=str(row.get('class_name') or '').strip()
            sec=str(row.get('section_name') or '').strip()
            if not ADMISSION_RE.match(adm):
                errors.append(f'Row {idx}: invalid admission number {adm or "(blank)"}.'); continue
            if not name or len(name)>120:
                errors.append(f'Row {idx}: missing or invalid student name.'); continue
            if (cl and cl not in ACADEMY_GRADES) or len(sec)>40:
                errors.append(f'Row {idx}: choose a valid O-Level or A-Level grade and section.'); continue
            if adm in existing or adm in seen:
                errors.append(f'Row {idx}: {adm} already exists; skipped.'); continue
            code=new_activation_code(); expiry=activation_expiry()
            conn.execute('''INSERT INTO users(admission_no,full_name,role,status,class_name,section_name,activation_code,activation_code_expires_at,claimed,created_at)
                            VALUES (?,?,'student','unclaimed',?,?,?,?,0,?)''',(adm,name,cl,sec,code,expiry,iso_now()))
            created.append({'admission_no':adm,'full_name':name,'class_name':cl,'section_name':sec,'activation_code':code,'expires_at':expiry})
            seen.add(adm)
        audit(conn,a['id'],'student_bulk_import',f'created={len(created)}, skipped={len(errors)}')
    return render(request,'admin_import_result.html',{'created':created[:200],'created_count':len(created),'errors':errors[:100],'error_count':len(errors)})

@app.post('/admin/students/create')
def admin_student_create(request: Request, admission_no:str=Form(...), full_name:str=Form(...), class_name:str=Form(''), section_name:str=Form('')):
    a=require_admin(request,'students'); admission_no=admission_no.strip().upper()
    if not ADMISSION_RE.match(admission_no): return flash_redirect('/admin/students','Admission number format is invalid.','error')
    if class_name.strip() and class_name.strip() not in ACADEMY_GRADES: return flash_redirect('/admin/students','Choose a valid academy grade.','error')
    code=new_activation_code()
    try:
        with connect() as conn:
            conn.execute('''INSERT INTO users(admission_no,full_name,role,status,class_name,section_name,activation_code,activation_code_expires_at,claimed,created_at)
                            VALUES (?,?,"student","unclaimed",?,?,?,?,0,?)''',(admission_no,_clean_text(full_name,120),_clean_text(class_name,40,False),_clean_text(section_name,40,False),code,activation_expiry(),iso_now()))
            audit(conn,a['id'],'student_created',admission_no)
        return flash_redirect('/admin/students',f'Student added. Activation code: {code}')
    except INTEGRITY_ERRORS:
        return flash_redirect('/admin/students','That admission number already exists.','error')


@app.post('/admin/students/{student_id}/edit')
def admin_student_edit(request: Request, student_id:int, full_name:str=Form(...), class_name:str=Form(''), section_name:str=Form(''),
                       guardian_name:Optional[str]=Form(None), phone:Optional[str]=Form(None), country_code:Optional[str]=Form(None),
                       email:Optional[str]=Form(None), country:Optional[str]=Form(None), school_name:Optional[str]=Form(None)):
    a=require_admin(request,'students')
    try:
        full_name=_clean_text(full_name,120); class_name=_clean_text(class_name,40,False); section_name=_clean_text(section_name,40,False)
        supplied={'guardianName':guardian_name,'phone':phone,'countryCode':country_code,'email':email,'country':country,'schoolName':school_name}
        supplied={k:_clean_text(v,20 if k=='countryCode' else 200,False) for k,v in supplied.items() if v is not None}
        if supplied.get('email') and not re.fullmatch(r'[^\s@]+@[^\s@]+\.[^\s@]+', supplied['email']): raise ValueError('Enter a valid email address.')
    except ValueError as exc: return flash_redirect('/admin/students',str(exc),'error')
    with connect() as conn:
        student=conn.execute('SELECT id, class_name FROM users WHERE id=? AND role="student"',(student_id,)).fetchone()
        if not student: return flash_redirect('/admin/students','Student not found.','error')
        # Preserve untouched legacy values; never create new unsupported grades.
        if class_name and class_name not in ACADEMY_GRADES and class_name != (student['class_name'] or ''):
            return flash_redirect('/admin/students','Choose a valid academy grade.','error')
        conn.execute('UPDATE users SET full_name=?,class_name=?,section_name=? WHERE id=? AND role="student"',(full_name,class_name,section_name,student_id))
        row=conn.execute('SELECT profile_json FROM academy_signup_profiles WHERE user_id=?',(student_id,)).fetchone()
        if row or any(supplied.values()):
            profile=academy_profile_from_row(row)
            profile.update(supplied); profile['fullName']=full_name; profile['grade']=class_name; profile['section']=section_name
            if class_name in ACADEMY_GRADES: profile['program']='O-Level' if class_name.startswith('O-Level') else 'A-Level'
            conn.execute('INSERT INTO academy_signup_profiles(user_id,profile_json,created_at) VALUES (?,?,?) ON CONFLICT(user_id) DO UPDATE SET profile_json=excluded.profile_json', (student_id,json.dumps(profile),iso_now()))
        audit(conn,a['id'],'student_updated',f'{student_id}: {full_name}')
    return flash_redirect('/admin/students','Student details updated.')

@app.post('/admin/students/{student_id}/photo')
async def admin_student_photo(request: Request, student_id:int, photo:UploadFile=File(...)):
    a=require_admin(request,'students')
    ext=Path(photo.filename or '').suffix.lower()
    if ext not in {'.png','.jpg','.jpeg','.webp'}: return flash_redirect('/admin/students','Please upload a PNG, JPG, or WEBP image.','error')
    with connect() as conn:
        student=conn.execute('SELECT id,admission_no FROM users WHERE id=? AND role="student"',(student_id,)).fetchone()
    if not student: return flash_redirect('/admin/students','Student not found.','error')
    try: path=_save_profile_picture(await photo.read(),student_id)
    except ValueError as exc: return flash_redirect('/admin/students',str(exc),'error')
    with connect() as conn:
        conn.execute('UPDATE users SET profile_picture_path=? WHERE id=?',(path,student_id)); audit(conn,a['id'],'student_profile_photo_updated',student['admission_no'])
    return flash_redirect('/admin/students','Student profile picture updated.')

@app.post('/admin/students/{student_id}/photo/remove')
def admin_student_photo_remove(request: Request, student_id:int):
    a=require_admin(request,'students')
    with connect() as conn:
        student=conn.execute('SELECT id,admission_no FROM users WHERE id=? AND role="student"',(student_id,)).fetchone()
        if not student: return flash_redirect('/admin/students','Student not found.','error')
        conn.execute('UPDATE users SET profile_picture_path=NULL WHERE id=?',(student_id,)); audit(conn,a['id'],'student_profile_photo_removed',student['admission_no'])
    delete_upload(f'profile_{student_id}.webp')
    return flash_redirect('/admin/students','Student profile picture removed.')

@app.post('/admin/students/{student_id}/status')
def admin_student_status(request: Request, student_id:int, status:str=Form(...)):
    a=require_admin(request,'students')
    if status not in {'active','disabled','unclaimed'}: return flash_redirect('/admin/students','Invalid status.','error')
    with connect() as conn:
        conn.execute('UPDATE users SET status=? WHERE id=? AND role="student"',(status,student_id))
        if status!='active': conn.execute('DELETE FROM sessions WHERE user_id=?',(student_id,))
        audit(conn,a['id'],'student_status_changed',f'{student_id}->{status}')
    return flash_redirect('/admin/students','Student status updated.')

