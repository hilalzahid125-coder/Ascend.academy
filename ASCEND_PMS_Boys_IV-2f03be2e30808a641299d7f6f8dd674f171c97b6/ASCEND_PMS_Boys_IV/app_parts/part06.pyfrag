@app.post('/admin/challenges/{challenge_id}/status')
def admin_challenge_status(request: Request,challenge_id:int,status:str=Form(...)):
    a=require_admin(request,'challenges')
    if status not in {'draft','scheduled','active','completed','expired','archived'}: return flash_redirect('/admin/challenges','Invalid status.','error')
    with connect() as conn:
        conn.execute('UPDATE challenges SET status=? WHERE id=?',(status,challenge_id)); audit(conn,a['id'],'challenge_status_changed',f'{challenge_id}->{status}')
    return flash_redirect('/admin/challenges','Challenge status updated.')

@app.post('/admin/submissions/{participation_id}/review')
def admin_submission_review(request: Request,participation_id:int,decision:str=Form(...),review_note:str=Form('')):
    a=require_admin(request,'challenges')
    if decision not in {'approved','rejected'}: return flash_redirect('/admin/challenges','Invalid review decision.','error')
    try: review_note=_clean_text(review_note,1000,False)
    except ValueError as exc: return flash_redirect('/admin/challenges',str(exc),'error')
    with connect() as conn:
        # Serialize reviews so simultaneous approvals cannot award points twice.
        conn.execute('BEGIN IMMEDIATE')
        cp=conn.execute('''SELECT cp.*,c.points,c.category,c.title,u.full_name FROM challenge_participations cp
                           JOIN challenges c ON c.id=cp.challenge_id JOIN users u ON u.id=cp.user_id WHERE cp.id=?''',(participation_id,)).fetchone()
        if not cp: return flash_redirect('/admin/challenges','Submission not found.','error')
        if cp['status'] != 'pending': return flash_redirect('/admin/challenges','This submission is not awaiting review.','error')
        if decision=='approved' and not cp['awarded']:
            conn.execute('INSERT INTO point_transactions(user_id,amount,category,reason,challenge_id,admin_id,created_at) VALUES (?,?,?,?,?,?,?)',
                         (cp['user_id'],cp['points'],cp['category'],f'Challenge: {cp["title"]}',cp['challenge_id'],a['id'],iso_now()))
            sync_achievements(conn,cp['user_id'])
            conn.execute('UPDATE challenge_participations SET status="approved",review_note=?,awarded=1,updated_at=? WHERE id=?',(review_note,iso_now(),participation_id))
            notify(conn,cp['user_id'],'Challenge approved',f'You earned {cp["points"]} points for {cp["title"]}.')
        else:
            conn.execute('UPDATE challenge_participations SET status=?,review_note=?,updated_at=? WHERE id=?',(decision,review_note,iso_now(),participation_id))
            notify(conn,cp['user_id'],'Challenge reviewed',f'Your submission for {cp["title"]} was {decision}.')
        audit(conn,a['id'],'submission_reviewed',f'{participation_id}->{decision}')
    return flash_redirect('/admin/challenges','Submission reviewed.')


