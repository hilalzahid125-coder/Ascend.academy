('UPDATE users SET password_hash=NULL,claimed=0,status="unclaimed",activation_code=?,activation_code_expires_at=? WHERE id=? AND role="student"',(code,activation_expiry(),student_id))
        conn.execute('DELETE FROM sessions WHERE user_id=?',(student_id,))
        audit(conn,a['id'],'student_password_reset',f'student_id={student_id}')
    return flash_redirect('/admin/students',f'Account reset. New activation code: {code}')

@app.post('/admin/students/{student_id}/points')
def admin_points(request: Request, student_id:int, amount:int=Form(...), category:str=Form('general'), reason:str=Form(...)):
    a=require_admin(request,'students'); category=category if category in ALLOWED_CATEGORIES else 'general'
    if amount==0 or abs(amount)>100000: return flash_redirect('/admin/students','Point amount is invalid.','error')
    try: reason=_clean_text(reason,240)
    except ValueError as exc: return flash_redirect('/admin/students',str(exc),'error')
    with connect() as conn:
        s=conn.execute('SELECT * FROM users WHERE id=? AND role="student"',(student_id,)).fetchone()
        if not s: return flash_redirect('/admin/students','Student not found.','error')
        conn.execute('INSERT INTO point_transactions(user_id,amount,category,reason,admin_id,created_at) VALUES (?,?,?,?,?,?)',(student_id,amount,category,reason,a['id'],iso_now()))
        sync_achievements(conn,student_id)
        notify(conn,student_id,'Points updated',f'{amount:+d} points — {reason}')
        audit(conn,a['id'],'points_changed',f'{s["admission_no"]}: {amount:+d} / {category} / {reason}')
    return flash_redirect('/admin/students','Points updated successfully.')

@app.get('/admin/challenges', response_class=HTMLResponse)
def admin_challenges(request: Request):
    require_admin(request,'challenges')
    with connect() as conn:
        rows=conn.execute('SELECT * FROM challenges ORDER BY id DESC').fetchall()
        pending=conn.execute('''SELECT cp.*,c.title,u.full_name,u.admission_no FROM challenge_participations cp
                                JOIN challenges c ON c.id=cp.challenge_id JOIN users u ON u.id=cp.user_id
                                WHERE cp.status='pending' ORDER BY cp.id DESC''').fetchall()
    return render(request,'admin_challenges.html',{'challenges':rows,'pending':pending})

@app.post('/admin/challenges/create')
def admin_challenge_create(request: Request,title:str=Form(...),description:str=Form(...),category:str=Form('general'),points:int=Form(0),status:str=Form('draft'),start_date:str=Form(''),end_date:str=Form(''),eligibility_class:str=Form(''),eligibility_section:str=Form('')):
    a=require_admin(request,'challenges'); category=category if category in ALLOWED_CATEGORIES else 'general'
    if status not in {'draft','scheduled','active','completed','expired','archived'}: status='draft'
    if points<0 or points>10000: return flash_redirect('/admin/challenges','Challenge points must be between 0 and 10,000.','error')
    try:
        title=_clean_text(title,140); description=_clean_text(description,5000); eligibility_class=_clean_text(eligibility_class,40,False); eligibility_section=_clean_text(eligibility_section,40,False)
    except ValueError as exc: return flash_redirect('/admin/challenges',str(exc),'error')
    with connect() as conn:
        conn.execute('''INSERT INTO challenges(title,description,category,points,start_date,end_date,status,eligibility_class,eligibility_section,created_by,created_at)
                        VALUES (?,?,?,?,?,?,?,?,?,?,?)''',(title.strip(),description.strip(),category,points,start_date or None,end_date or None,status,eligibility_class or None,eligibility_section or None,a['id'],iso_now()))
        audit(conn,a['id'],'challenge_created',title.strip())
    return flash_redirect('/admin/challenges','Challenge created.')


@app.post('/admin/challenges/{challenge_id}/edit')
def admin_challenge_edit(request: Request,challenge_id:int,title:str=Form(...),description:str=Form(...),category:str=Form('general'),points:int=Form(0),start_date:str=Form(''),end_date:str=Form(''),eligibility_class:str=Form(''),eligibility_section:str=Form('')):
    a=require_admin(request,'challenges'); category=category if category in ALLOWED_CATEGORIES else 'general'
    if points<0 or points>10000: return flash_redirect('/admin/challenges','Challenge points must be between 0 and 10,000.','error')
    try:
        title=_clean_text(title,140); description=_clean_text(description,5000); eligibility_class=_clean_text(eligibility_class,40,False); eligibility_section=_clean_text(eligibility_section,40,False)
    except ValueError as exc: return flash_redirect('/admin/challenges',str(exc),'error')
    with connect() as conn:
        conn.execute('UPDATE challenges SET title=?,description=?,category=?,points=?,start_date=?,end_date=?,eligibility_class=?,eligibility_section=? WHERE id=?',(title,description,category,points,start_date or None,end_date or None,eligibility_class or None,eligibility_section or None,challenge_id))
        audit(conn,a['id'],'challenge_updated',f'{challenge_id}: {title.strip()}')
