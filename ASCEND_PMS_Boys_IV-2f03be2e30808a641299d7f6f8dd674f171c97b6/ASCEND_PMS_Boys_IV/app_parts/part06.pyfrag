@app.post('/admin/achievements/create')
def admin_achievement_create(request: Request,name:str=Form(...),description:str=Form(...),category:str=Form('overall'),points_required:int=Form(...)):
    a=require_admin(request,'achievements')
    if category not in {'overall'}|ALLOWED_CATEGORIES: category='overall'
    if points_required<0 or points_required>1_000_000: return flash_redirect('/admin/achievements','Points requirement is invalid.','error')
    try: name=_clean_text(name,120); description=_clean_text(description,1000)
    except ValueError as exc: return flash_redirect('/admin/achievements',str(exc),'error')
    with connect() as conn:
        conn.execute('INSERT INTO achievements(name,description,category,points_required,status,created_at) VALUES (?,?,?,?,"active",?)',(name,description,category,points_required,iso_now()))
        audit(conn,a['id'],'achievement_created',name.strip())