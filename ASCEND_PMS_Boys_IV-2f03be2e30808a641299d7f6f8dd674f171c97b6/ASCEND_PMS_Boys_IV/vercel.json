{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.py,app_parts/**,templates/**,static/**,supabase/migrations/**,VERSION}",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/internal/scheduled-backup", "schedule": "0 2 * * *" }]
}
